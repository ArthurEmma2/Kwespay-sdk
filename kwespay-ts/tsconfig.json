{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "outDir": "dist/types",

    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}
